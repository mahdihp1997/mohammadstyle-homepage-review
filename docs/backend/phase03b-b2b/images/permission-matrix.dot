digraph{graph[bgcolor="#111b24",pad="0.35",nodesep="0.35",ranksep="0.55"];node[shape=box,style="rounded,filled",fillcolor="#213444",color="#d9c79e",fontcolor="#f3f6fa",fontname="Arial",fontsize=19,margin="0.18,0.14"];edge[color="#d9c79e",fontcolor="#e5d6b5",fontname="Arial",fontsize=15];node[shape=plain];matrix[label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="12" COLOR="#d9c79e" BGCOLOR="#213444"><TR><TD><B>Explicit permission / operation</B></TD><TD><B>Owner</B></TD><TD><B>Manager</B></TD><TD><B>Reception</B></TD><TD><B>Barber</B></TD><TD><B>Customer</B></TD></TR><TR><TD>Global staff create / activate</TD><TD>Business</TD><TD>No</TD><TD>No</TD><TD>No</TD><TD>No</TD></TR><TR><TD>staff.link / staff.qualify</TD><TD>Business</TD><TD>No</TD><TD>No</TD><TD>No</TD><TD>No</TD></TR><TR><TD>Branch membership / eligibility</TD><TD>Business</TD><TD>Assigned branch</TD><TD>No</TD><TD>No</TD><TD>No</TD></TR><TR><TD>schedule.manage / branch rules</TD><TD>Business</TD><TD>Assigned branch</TD><TD>No</TD><TD>No</TD><TD>No</TD></TR><TR><TD>schedule.publish / reviewed withdrawal</TD><TD>Business</TD><TD>Assigned branch</TD><TD>No</TD><TD>No</TD><TD>No</TD></TR><TR><TD>resource.manage / branchhours.manage</TD><TD>Business</TD><TD>Assigned branch</TD><TD>No</TD><TD>No</TD><TD>No</TD></TR><TR><TD>timeoff.approve: global staff leave</TD><TD>Business</TD><TD>No</TD><TD>No</TD><TD>No</TD><TD>No</TD></TR><TR><TD>timeoff.approve: branch closure</TD><TD>Business</TD><TD>Assigned branch</TD><TD>No</TD><TD>No</TD><TD>No</TD></TR><TR><TD>schedule.read / scoped staff.read</TD><TD>Business</TD><TD>Assigned branch</TD><TD>Delegated reads</TD><TD>No</TD><TD>No</TD></TR><TR><TD>schedule.read.own</TD><TD>Explicit grants</TD><TD>Explicit grants</TD><TD>No</TD><TD>Verified own only</TD><TD>No</TD></TR><TR><TD COLSPAN="6">Role labels grant nothing. Every request requires current session + permission + object/branch evidence.</TD></TR></TABLE>>];}
