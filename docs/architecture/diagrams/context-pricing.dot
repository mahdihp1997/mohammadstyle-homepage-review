digraph G { graph [newrank=true,rankdir=TB,bgcolor="#f8fafc",fontname="Arial",fontsize=22,labelloc=t,label="Pricing / bounded-context ERD\nPHASE03A / PROPOSAL ONLY / HARDENING REVIEW",pad="0.35",nodesep="0.4",ranksep="0.65",splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#fff",color="#94a3b8",fontname="Arial",fontsize=16,margin="0.2,0.14"]; edge [fontname="Arial",fontsize=12,color="#64748b",arrowsize=0.7]; pricing_quote [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>pricing_quote</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">branch_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">customer_id [FK]</TD><TD ALIGN="LEFT">uuid?</TD></TR><TR><TD ALIGN="LEFT">quote_hash</TD><TD ALIGN="LEFT">bytea</TD></TR><TR><TD ALIGN="LEFT">hash_version</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">content_document</TD><TD ALIGN="LEFT">jsonb</TD></TR><TR><TD ALIGN="LEFT">currency_code</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">unit_version</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">total_rial</TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT">deposit_rial</TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD COLSPAN="2">B3_B4_COHORT / details in dictionary</TD></TR></TABLE>>];
pricing_quote_item [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>pricing_quote_item</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">quote_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">branch_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">offering_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">service_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">package_id [FK]</TD><TD ALIGN="LEFT">uuid?</TD></TR><TR><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT">offering_version</TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT">unit_price_rial</TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD COLSPAN="2">B3_B4_COHORT / details in dictionary</TD></TR></TABLE>>];
branch [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="branch\nexternal context / UUID reference"];
customer [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="customer\nexternal context / UUID reference"];
branch_service_offering [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="branch_service_offering\nexternal context / UUID reference"];
package [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="package\nexternal context / UUID reference"];
pricing_quote->branch [label="branch_id",tooltip="(business_id,branch_id) -> (business_id,id)"];
pricing_quote->customer [label="customer_id",tooltip="(business_id,customer_id) -> (business_id,id)"];
pricing_quote_item->pricing_quote [label="quote_id",tooltip="(business_id,quote_id,branch_id) -> (business_id,id,branch_id)"];
pricing_quote_item->branch_service_offering [label="offering_id",tooltip="(business_id,offering_id,branch_id,service_id) -> (business_id,id,branch_id,service_id)"];
pricing_quote_item->package [label="package_id",tooltip="(business_id,package_id) -> (business_id,id)"];
legend [shape=note,label="Owned tables: 2 / dashed nodes: external references\nChild -> parent FK; common business/created_by edges omitted only in this view.\nKey field projection (up to10/table); complete columns/constraints remain in dictionary/full ERD.\nNo database or migration executed."]; }
