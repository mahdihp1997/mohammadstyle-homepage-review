digraph G { graph [newrank=true,rankdir=TB,bgcolor="#f8fafc",fontname="Arial",fontsize=22,labelloc=t,label="Booking / bounded-context ERD\nPHASE03A / PROPOSAL ONLY / HARDENING REVIEW",pad="0.35",nodesep="0.4",ranksep="0.65",splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#fff",color="#94a3b8",fontname="Arial",fontsize=16,margin="0.2,0.14"]; edge [fontname="Arial",fontsize=12,color="#64748b",arrowsize=0.7]; booking [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>booking</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">branch_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">customer_id [FK]</TD><TD ALIGN="LEFT">uuid?</TD></TR><TR><TD ALIGN="LEFT">active_revision_id [FK]</TD><TD ALIGN="LEFT">uuid?</TD></TR><TR><TD ALIGN="LEFT">plan_committed</TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD ALIGN="LEFT">draft_expires_at</TD><TD ALIGN="LEFT">timestamptz?</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">origin</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">cancelled_at</TD><TD ALIGN="LEFT">timestamptz?</TD></TR><TR><TD ALIGN="LEFT">cancellation_reason_code</TD><TD ALIGN="LEFT">text?</TD></TR><TR><TD COLSPAN="2">B3_B4_COHORT / details in dictionary</TD></TR></TABLE>>];
