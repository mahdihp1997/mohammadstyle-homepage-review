digraph G { graph [newrank=true,rankdir=TB,bgcolor="#f8fafc",fontname="Arial",fontsize=22,labelloc=t,label="Business / bounded-context ERD\nPHASE03A / PROPOSAL ONLY / HARDENING REVIEW",pad="0.35",nodesep="0.4",ranksep="0.65",splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#fff",color="#94a3b8",fontname="Arial",fontsize=16,margin="0.2,0.14"]; edge [fontname="Arial",fontsize=12,color="#64748b",arrowsize=0.7]; business [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>business</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">brand_name</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">legal_name</TD><TD ALIGN="LEFT">text?</TD></TR><TR><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">currency_code</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD COLSPAN="2">B1 / details in dictionary</TD></TR></TABLE>>];
branch [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>branch</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">text?</TD></TR><TR><TD ALIGN="LEFT">time_zone</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD ALIGN="LEFT">bookable</TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD ALIGN="LEFT">configuration_version</TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD COLSPAN="2">B1 / details in dictionary</TD></TR></TABLE>>];
legend [shape=note,label="Owned tables: 2 / dashed nodes: external references\nChild -> parent FK; common business/created_by edges omitted only in this view.\nKey field projection (up to10/table); complete columns/constraints remain in dictionary/full ERD.\nNo database or migration executed."]; }
