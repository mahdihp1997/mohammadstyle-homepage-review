digraph G { graph [newrank=true,rankdir=TB,bgcolor="#f8fafc",fontname="Arial",fontsize=22,labelloc=t,label="Audit / bounded-context ERD\nPHASE03A / PROPOSAL ONLY / HARDENING REVIEW",pad="0.35",nodesep="0.4",ranksep="0.65",splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#fff",color="#94a3b8",fontname="Arial",fontsize=16,margin="0.2,0.14"]; edge [fontname="Arial",fontsize=12,color="#64748b",arrowsize=0.7]; audit_log [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>audit_log</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">actor_user_id [FK]</TD><TD ALIGN="LEFT">uuid?</TD></TR><TR><TD ALIGN="LEFT">branch_id [FK]</TD><TD ALIGN="LEFT">uuid?</TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">target_type</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">target_id</TD><TD ALIGN="LEFT">uuid?</TD></TR><TR><TD ALIGN="LEFT">request_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">reason_code</TD><TD ALIGN="LEFT">text?</TD></TR><TR><TD ALIGN="LEFT">redacted_change</TD><TD ALIGN="LEFT">jsonb?</TD></TR><TR><TD COLSPAN="2">B1 / details in dictionary</TD></TR></TABLE>>];
app_user [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="app_user\nexternal context / UUID reference"];
branch [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="branch\nexternal context / UUID reference"];
audit_log->app_user [label="actor_user_id",tooltip="(actor_user_id) -> (id)"];
audit_log->branch [label="branch_id",tooltip="(business_id,branch_id) -> (business_id,id)"];
legend [shape=note,label="Owned tables: 1 / dashed nodes: external references\nChild -> parent FK; common business/created_by edges omitted only in this view.\nKey field projection (up to10/table); complete columns/constraints remain in dictionary/full ERD.\nNo database or migration executed."]; }
