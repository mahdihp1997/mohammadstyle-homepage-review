digraph G { graph [newrank=true,rankdir=TB,bgcolor="#f8fafc",fontname="Arial",fontsize=22,labelloc=t,label="Payments / bounded-context ERD\nPHASE03A / PROPOSAL ONLY / HARDENING REVIEW",pad="0.35",nodesep="0.4",ranksep="0.65",splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#fff",color="#94a3b8",fontname="Arial",fontsize=16,margin="0.2,0.14"]; edge [fontname="Arial",fontsize=12,color="#64748b",arrowsize=0.7]; payment_intent [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>payment_intent</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">revision_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">hold_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">purpose</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">currency_code</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">unit_version</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">amount_rial</TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT">provider_key</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">provider_idempotency_key</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD COLSPAN="2">B6 / details in dictionary</TD></TR></TABLE>>];
