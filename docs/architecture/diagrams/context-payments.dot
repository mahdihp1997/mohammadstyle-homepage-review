booking_policy_acceptance [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="booking_policy_acceptance\nexternal context / UUID reference"];
app_user [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="app_user\nexternal context / UUID reference"];
