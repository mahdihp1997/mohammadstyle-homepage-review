digraph G { graph [newrank=true,rankdir=TB,bgcolor="#f8fafc",fontname="Arial",fontsize=22,labelloc=t,label="Infrastructure / bounded-context ERD\nPHASE03A / PROPOSAL ONLY / HARDENING REVIEW",pad="0.35",nodesep="0.4",ranksep="0.65",splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#fff",color="#94a3b8",fontname="Arial",fontsize=16,margin="0.2,0.14"]; edge [fontname="Arial",fontsize=12,color="#64748b",arrowsize=0.7]; idempotency_record [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>idempotency_record</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">actor_key</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">route_key</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">idempotency_key</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">request_hash</TD><TD ALIGN="LEFT">bytea</TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">response_code</TD><TD ALIGN="LEFT">integer?</TD></TR><TR><TD ALIGN="LEFT">response_snapshot</TD><TD ALIGN="LEFT">jsonb?</TD></TR><TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR><TR><TD COLSPAN="2">B1 / details in dictionary</TD></TR></TABLE>>];
outbox_event [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>outbox_event</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">aggregate_type</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">aggregate_id</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">aggregate_version</TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">schema_version</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT">jsonb</TD></TR><TR><TD ALIGN="LEFT">available_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT">published_at</TD><TD ALIGN="LEFT">timestamptz?</TD></TR><TR><TD ALIGN="LEFT">publish_attempts</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD COLSPAN="2">B1 / details in dictionary</TD></TR></TABLE>>];
consumer_inbox [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>consumer_inbox</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">event_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">consumer_key</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">processed_at</TD><TD ALIGN="LEFT">timestamptz?</TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD COLSPAN="2">B1 / details in dictionary</TD></TR></TABLE>>];
consumer_inbox->outbox_event [label="event_id",tooltip="(business_id,event_id) -> (business_id,id)"];
legend [shape=note,label="Owned tables: 3 / dashed nodes: external references\nChild -> parent FK; common business/created_by edges omitted only in this view.\nKey field projection (up to10/table); complete columns/constraints remain in dictionary/full ERD.\nNo database or migration executed."]; }
