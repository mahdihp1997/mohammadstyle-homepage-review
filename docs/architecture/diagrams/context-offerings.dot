digraph G { graph [newrank=true,rankdir=TB,bgcolor="#f8fafc",fontname="Arial",fontsize=22,labelloc=t,label="Offerings / bounded-context ERD\nPHASE03A / PROPOSAL ONLY / HARDENING REVIEW",pad="0.35",nodesep="0.4",ranksep="0.65",splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#fff",color="#94a3b8",fontname="Arial",fontsize=16,margin="0.2,0.14"]; edge [fontname="Arial",fontsize=12,color="#64748b",arrowsize=0.7]; branch_service_offering [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>branch_service_offering</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">branch_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">service_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD ALIGN="LEFT">price_rial</TD><TD ALIGN="LEFT">bigint?</TD></TR><TR><TD ALIGN="LEFT">duration_minutes</TD><TD ALIGN="LEFT">integer?</TD></TR><TR><TD ALIGN="LEFT">buffer_before_minutes</TD><TD ALIGN="LEFT">integer?</TD></TR><TR><TD ALIGN="LEFT">buffer_after_minutes</TD><TD ALIGN="LEFT">integer?</TD></TR><TR><TD ALIGN="LEFT">configuration_version</TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT">resources_confirmed</TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD COLSPAN="2">B1 / details in dictionary</TD></TR></TABLE>>];
offering_staff_eligibility [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>offering_staff_eligibility</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">offering_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">branch_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">service_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">assignment_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">staff_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">qualification_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD COLSPAN="2">B2 / details in dictionary</TD></TR></TABLE>>];
offering_resource_requirement [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>offering_resource_requirement</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">offering_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">branch_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">service_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">resource_kind</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">integer</TD></TR><TR><TD COLSPAN="2">B1 / details in dictionary</TD></TR></TABLE>>];
branch [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="branch\nexternal context / UUID reference"];
service [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="service\nexternal context / UUID reference"];
staff_branch_assignment [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="staff_branch_assignment\nexternal context / UUID reference"];
staff_service_eligibility [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="staff_service_eligibility\nexternal context / UUID reference"];
branch_service_offering->branch [label="branch_id",tooltip="(business_id,branch_id) -> (business_id,id)"];
branch_service_offering->service [label="service_id",tooltip="(business_id,service_id) -> (business_id,id)"];
offering_staff_eligibility->branch_service_offering [label="offering_id",tooltip="(business_id,offering_id,branch_id,service_id) -> (business_id,id,branch_id,service_id)"];
offering_staff_eligibility->staff_branch_assignment [label="assignment_id",tooltip="(business_id,assignment_id,staff_id,branch_id) -> (business_id,id,staff_id,branch_id)"];
offering_staff_eligibility->staff_service_eligibility [label="qualification_id",tooltip="(business_id,qualification_id,staff_id,service_id) -> (business_id,id,staff_id,service_id)"];
offering_resource_requirement->branch_service_offering [label="offering_id",tooltip="(business_id,offering_id,branch_id,service_id) -> (business_id,id,branch_id,service_id)"];
legend [shape=note,label="Owned tables: 3 / dashed nodes: external references\nChild -> parent FK; common business/created_by edges omitted only in this view.\nKey field projection (up to10/table); complete columns/constraints remain in dictionary/full ERD.\nNo database or migration executed."]; }
