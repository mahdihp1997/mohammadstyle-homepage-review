digraph G { graph [newrank=true,rankdir=TB,bgcolor="#f8fafc",fontname="Arial",fontsize=22,labelloc=t,label="Staff / bounded-context ERD\nPHASE03A / PROPOSAL ONLY / HARDENING REVIEW",pad="0.35",nodesep="0.4",ranksep="0.65",splines=polyline]; node [shape=box,style="rounded,filled",fillcolor="#fff",color="#94a3b8",fontname="Arial",fontsize=16,margin="0.2,0.14"]; edge [fontname="Arial",fontsize=12,color="#64748b",arrowsize=0.7]; staff [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>staff</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">user_id [FK]</TD><TD ALIGN="LEFT">uuid?</TD></TR><TR><TD ALIGN="LEFT">resource_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">resource_kind [FK]</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD COLSPAN="2">B2 / details in dictionary</TD></TR></TABLE>>];
staff_branch_assignment [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>staff_branch_assignment</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">staff_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">branch_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">valid_from</TD><TD ALIGN="LEFT">date</TD></TR><TR><TD ALIGN="LEFT">valid_to</TD><TD ALIGN="LEFT">date?</TD></TR><TR><TD ALIGN="LEFT">membership_period [generated]</TD><TD ALIGN="LEFT">daterange</TD></TR><TR><TD ALIGN="LEFT">voided_at</TD><TD ALIGN="LEFT">timestamptz?</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD ALIGN="LEFT">void_reason</TD><TD ALIGN="LEFT">text?</TD></TR><TR><TD COLSPAN="2">B2 / details in dictionary</TD></TR></TABLE>>];
staff_service_eligibility [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>staff_service_eligibility</B></TD></TR><TR><TD ALIGN="LEFT">id [PK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">staff_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">service_id [FK]</TD><TD ALIGN="LEFT">uuid</TD></TR><TR><TD ALIGN="LEFT">verified_at</TD><TD ALIGN="LEFT">timestamptz?</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">boolean</TD></TR><TR><TD COLSPAN="2">B2 / details in dictionary</TD></TR></TABLE>>];
app_user [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="app_user\nexternal context / UUID reference"];
resource [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="resource\nexternal context / UUID reference"];
branch [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="branch\nexternal context / UUID reference"];
service [shape=box,style="rounded,dashed",fillcolor="#f1f5f9",label="service\nexternal context / UUID reference"];
staff->app_user [label="user_id",tooltip="(user_id) -> (id)"];
staff->resource [label="resource_id",tooltip="(business_id,resource_id,resource_kind) -> (business_id,id,kind)"];
staff_branch_assignment->staff [label="staff_id",tooltip="(business_id,staff_id) -> (business_id,id)"];
staff_branch_assignment->branch [label="branch_id",tooltip="(business_id,branch_id) -> (business_id,id)"];
staff_service_eligibility->staff [label="staff_id",tooltip="(business_id,staff_id) -> (business_id,id)"];
staff_service_eligibility->service [label="service_id",tooltip="(business_id,service_id) -> (business_id,id)"];
legend [shape=note,label="Owned tables: 3 / dashed nodes: external references\nChild -> parent FK; common business/created_by edges omitted only in this view.\nKey field projection (up to10/table); complete columns/constraints remain in dictionary/full ERD.\nNo database or migration executed."]; }
