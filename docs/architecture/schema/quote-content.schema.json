{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/spec/ms-quote-content-v2",
  "title": "MS_QUOTE_CONTENT_V2 exact integrity payload (proposal, not API implementation)",
  "description": "All keys recursively allowlisted/required; no implicit defaults. Arrays normalized as in QUOTE_HASH_CONTRACT.md. Decimal strings forbid floating point. UTC millisecond instants; invalid dates/unsafe bounds rejected by future semantic validator. No customer/quote/idempotency/expiry identity fields.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "MS_QUOTE_CONTENT_V2"
    },
    "businessId": {
      "type": "string",
      "format": "uuid"
    },
    "branchId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "const": "SERVER"
    },
    "currency": {
      "const": "IRR"
    },
    "unitVersion": {
      "const": "IRR_RIAL_V1"
    },
    "configurationFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "startsAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "endsAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "optionalDepositChosen": {
      "type": "boolean"
    },
    "totalRial": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*0)$"
    },
    "depositRial": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*0)$"
    },
    "remainingRial": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*0)$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "position": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "offeringId": {
            "type": "string",
            "format": "uuid"
          },
          "serviceId": {
            "type": "string",
            "format": "uuid"
          },
          "packageId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "offeringVersion": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "quantity": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "unitPriceRial": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*0)$"
          },
          "durationMinutes": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "bufferBeforeMinutes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "bufferAfterMinutes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        },
        "required": [
          "position",
          "offeringId",
          "serviceId",
          "packageId",
          "offeringVersion",
          "quantity",
          "displayName",
          "unitPriceRial",
          "durationMinutes",
          "bufferBeforeMinutes",
          "bufferAfterMinutes"
        ]
      },
      "minItems": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "quoteItemPosition": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "offeringId": {
            "type": "string",
            "format": "uuid"
          },
          "staffId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "endsAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "durationMinutes": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "bufferBeforeMinutes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "bufferAfterMinutes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "resourceId": {
                  "type": "string",
                  "format": "uuid"
                },
                "kind": {
                  "enum": [
                    "STAFF",
                    "CHAIR",
                    "ROOM",
                    "DEVICE"
                  ]
                }
              },
              "required": [
                "resourceId",
                "kind"
              ]
            },
            "minItems": 1
          },
          "dependsOnSequences": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "minItems": 0
          }
        },
        "required": [
          "sequence",
          "quoteItemPosition",
          "offeringId",
          "staffId",
          "startsAt",
          "endsAt",
          "durationMinutes",
          "bufferBeforeMinutes",
          "bufferAfterMinutes",
          "resources",
          "dependsOnSequences"
        ]
      },
      "minItems": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versionId": {
          "type": "string",
          "format": "uuid"
        },
        "versionNumber": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshotHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resolverVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceAssignments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "quoteItemPosition": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "assignmentId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "quoteItemPosition",
              "assignmentId"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "versionId",
        "versionNumber",
        "contentHash",
        "snapshotHash",
        "resolverVersion",
        "sourceAssignments"
      ]
    }
  },
  "required": [
    "schema",
    "businessId",
    "branchId",
    "source",
    "currency",
    "unitVersion",
    "configurationFingerprint",
    "timeZone",
    "startsAt",
    "endsAt",
    "optionalDepositChosen",
    "totalRial",
    "depositRial",
    "remainingRial",
    "items",
    "segments",
    "policy"
  ]
}
