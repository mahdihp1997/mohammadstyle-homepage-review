# Non-secret settings. Create secret files outside the repository.
PRODUCT_ENV=staging
PUBLIC_ORIGIN=https://salon.example.com
PUBLIC_HOST=salon.example.com
PRODUCT_BUSINESS_ID=REPLACE_WITH_GENERATED_UUID
PGDATABASE=mohammadstyle
SECRETS_DIR=/srv/mohammadstyle/secrets
BACKUP_ROOT=/srv/mohammadstyle/backups
BACKUP_SET=REPLACE_WITH_UNIQUE_TIMESTAMP
RELEASE_TAG=REPLACE_WITH_IMMUTABLE_COMMIT
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
SMS_PROVIDER=none
SMS_OTP_TEMPLATE=
SMS_SENDER=
MS_PRODUCT_PUBLISH=0
