{
  "name": "mohammadstyle-b0-foundation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.16.0 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "env:init": "node scripts/infra.mjs env",
    "infra:up": "node scripts/infra.mjs up",
    "infra:db": "node scripts/infra.mjs db",
    "infra:stop": "node scripts/infra.mjs stop",
    "infra:reset": "node scripts/infra.mjs reset",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:db": "node scripts/validate-db.mjs",
    "test:prisma": "node scripts/prisma-probe.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "diagnostics": "node scripts/diagnostics.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
