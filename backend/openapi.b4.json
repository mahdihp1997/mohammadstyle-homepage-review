{
  "openapi": "3.1.0",
  "info": {
    "title": "Mohammad Style isolated B4 booking API",
    "version": "0.0.0-b4",
    "description": "Loopback-only test profile, not production login/payment. Every POST requires exact Origin http://127.0.0.1:3110, JSON, SameSite session and CSRF. State changes use verified test identities. Native SQL is authoritative; no client price/time/resource document is accepted. Next proxy is disabled by default and in production; accepts only 127.0.0.1:3000 with MS_BOOKING_SERVER_ENABLED=1. Confirm with deposit>0 stays PENDING_PAYMENT."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3110"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ms_session"
      }
    }
  },
  "paths": {
    "/api/v1/booking/commands/availability": {
      "post": {
        "operationId": "booking_availability",
        "summary": "availability",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "branchId",
                  "offeringIds",
                  "staffId",
                  "date",
                  "optionalDepositChosen",
                  "rescheduleBookingId",
                  "cursor"
                ],
                "properties": {
                  "branchId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "offeringIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "staffId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "optionalDepositChosen": {
                    "type": "boolean"
                  },
                  "rescheduleBookingId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cursor": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,3})$",
                    "description": "Local grid minute, 0..1439 and divisible by configured stride; initial 0. Up to six fully verified plans/page; follow nextCursor."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server result; reads do not create a booking. Idempotent replay retains original identity/expiry; read current status afterwards."
          },
          "401": {
            "description": "Unverified/expired session"
          },
          "403": {
            "description": "CSRF, Origin, role or verified identity denied"
          },
          "404": {
            "description": "Hidden/missing owned target"
          },
          "409": {
            "description": "Stale/expired quote or plan; resource conflict; invalid state"
          },
          "412": {
            "description": "Stale booking version"
          },
          "422": {
            "description": "Contract/configuration/consent/policy boundary rejected"
          },
          "429": {
            "description": "Bounded process rate limit"
          },
          "503": {
            "description": "Unavailable/unknown outcome: retry same idempotency key, then read current state"
          }
        }
      }
    },
